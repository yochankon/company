rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 입찰정보는 누구나 읽을 수 있고, 쓰기는 Cloud Function(Admin SDK)만 가능
    // (Admin SDK는 이 규칙을 우회하므로 클라이언트 쓰기만 명시적으로 막는다)
    match /bids/{bidId} {
      allow read: if true;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
